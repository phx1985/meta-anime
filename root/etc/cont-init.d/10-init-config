#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# =============================================================================
# Container initialization: PostgreSQL setup and secret generation
# Runs once on each container start; skips re-initialization if already done.
# =============================================================================

# Resolve the PostgreSQL binary directory dynamically (Alpine: /usr/libexec/postgresql*)
PG_BIN=$(find /usr/libexec -maxdepth 1 -name 'postgresql*' -type d 2>/dev/null | sort -V | tail -1)
if [ -z "${PG_BIN}" ]; then
    echo "[init] ERROR: No PostgreSQL installation found in /usr/libexec" >&2
    exit 1
fi
export PATH="${PG_BIN}:${PATH}"

# Ensure /config is owned by the service account before any work
chown -R abc:abc /config

# ─── PostgreSQL First-Run Initialization ─────────────────────────────────────
if [ ! -d /config/postgres ]; then
    echo "[init] Initializing PostgreSQL data directory…"
    mkdir -p /config/postgres
    chown abc:abc /config/postgres
    chmod 700 /config/postgres

    # Initialize the cluster as the abc user
    s6-setuidgid abc "${PG_BIN}/initdb" \
        -D /config/postgres \
        --auth-local=trust \
        --auth-host=md5 \
        --encoding=UTF8 \
        --locale=C

    # Start postgres temporarily via Unix socket for user/db creation.
    # Using listen_addresses='' disables TCP so only the local socket is used,
    # which matches the --auth-local=trust policy and requires no password.
    s6-setuidgid abc "${PG_BIN}/pg_ctl" \
        -D /config/postgres \
        -o "-c listen_addresses='' -c unix_socket_directories=/tmp" \
        -w start

    # Generate a cryptographically secure database password
    DB_PASSWORD=$(openssl rand -base64 32)
    if [ -z "${DB_PASSWORD}" ]; then
        echo "[init] ERROR: Failed to generate database password" >&2
        s6-setuidgid abc "${PG_BIN}/pg_ctl" -D /config/postgres -w stop
        exit 1
    fi

    # Create application role and database via the local Unix socket (trust auth)
    s6-setuidgid abc psql -h /tmp -d postgres \
        -c "CREATE USER metaanime WITH PASSWORD '${DB_PASSWORD}';" || {
        echo "[init] ERROR: Failed to create database user" >&2
        s6-setuidgid abc "${PG_BIN}/pg_ctl" -D /config/postgres -w stop
        exit 1
    }
    s6-setuidgid abc psql -h /tmp -d postgres \
        -c "CREATE DATABASE metaanime OWNER metaanime;" || {
        echo "[init] ERROR: Failed to create database" >&2
        s6-setuidgid abc "${PG_BIN}/pg_ctl" -D /config/postgres -w stop
        exit 1
    }

    # Shut down the temporary postgres instance
    s6-setuidgid abc "${PG_BIN}/pg_ctl" -D /config/postgres -w stop

    # Generate a cryptographically secure API key
    API_KEY=$(openssl rand -hex 32)
    if [ -z "${API_KEY}" ]; then
        echo "[init] ERROR: Failed to generate API key" >&2
        exit 1
    fi

    # Write the generated secrets to /config/appsettings.json.
    # The .NET application reads this file on every startup.
    # openssl rand -base64 produces [A-Za-z0-9+/=] — safe in JSON strings.
    # openssl rand -hex produces [0-9a-f] — safe in JSON strings.
    cat > /config/appsettings.json << EOF
{
  "Postgres": {
    "Host": "127.0.0.1",
    "User": "metaanime",
    "Password": "${DB_PASSWORD}",
    "Db": "metaanime"
  },
  "Authentication": {
    "ApiKey": "${API_KEY}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MyAnimeList": {
    "ApiBaseUrl": "https://api.myanimelist.net/v2",
    "WebBaseUrl": "https://myanimelist.net"
  }
}
EOF
    chown abc:abc /config/appsettings.json
    chmod 600 /config/appsettings.json

    echo "[init] Setup complete. Configuration written to /config/appsettings.json"
    echo "[init] API key generated. Use the X-Api-Key header with the value stored in /config/appsettings.json"
fi

# ─── Always write Angular runtime config ─────────────────────────────────────
# SECURITY: the runtime API key is NEVER written here. /config/wwwroot-assets is
# served unauthenticated at /assets, so a config.json containing the key would
# hand every visitor a full API credential. MetaAnime.Presentation serves
# /assets/config.json dynamically instead (see Program.cs): the key is returned
# only while no admin password exists (first-run wizard) or to authenticated
# callers. The file is still written (with an empty key) so stale files from
# older versions are scrubbed on upgrade and the SPA fetch keeps its shape.
mkdir -p /config/wwwroot-assets
cat > /config/wwwroot-assets/config.json << EOF
{
  "apiKey": ""
}
EOF
chown abc:abc /config/wwwroot-assets/config.json
echo "[init] Angular runtime config written to /config/wwwroot-assets/config.json (API key is served dynamically by the API, never from disk)"
