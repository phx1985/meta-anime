# =============================================================================
# Stage 1: Build Angular UI
# =============================================================================
FROM node:22-alpine AS ui-builder

WORKDIR /src
COPY ui/meta-anime-ui/package*.json ./
RUN npm ci
COPY ui/meta-anime-ui/ ./
RUN npm run build

# =============================================================================
# Stage 2: Build .NET API (debug configuration)
# =============================================================================
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS debug

WORKDIR /src
COPY api/ ./
# ServiceDefaults is referenced by Presentation as ../../MetaAnime.ServiceDefaults
COPY MetaAnime.ServiceDefaults/ /MetaAnime.ServiceDefaults/

# Copy Angular build output for static file serving
COPY --from=ui-builder /src/dist/meta-anime-ui/browser /src/MetaAnime.Presentation/wwwroot

EXPOSE 8080

CMD ["dotnet", "run", "--project", "MetaAnime.Presentation/MetaAnime.Presentation.csproj", "--urls", "http://0.0.0.0:8080"]
