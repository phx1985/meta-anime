# .env.example
# Copy this file to .env and fill in your values
# The .env file is gitignored and won't be committed

# ============================================================
# AUTHENTICATION (REQUIRED)
# ============================================================
Authentication__ApiKey=CHANGE_ME_SUPER_SECRET_KEY

# ============================================================
# DATABASE (PostgreSQL)
# ============================================================
Postgres__Host=postgres
Postgres__Port=5432
Postgres__Db=metaanime
Postgres__User=metaanime
Postgres__Password=metaanime_password

# ============================================================
# SONARR CONFIGURATION (Optional)
# ============================================================
Sonarr__Host=http://your-sonarr-host:8989
Sonarr__ApiKey=your_sonarr_api_key
Sonarr__AnimeTags=anime

# ============================================================
# PLEX CONFIGURATION (Optional)
# ============================================================
Plex__Host=http://your-plex-host:32400
Plex__Token=your_plex_token
Plex__AnimeSections=1,2

# ============================================================
# MYANIMELIST CONFIGURATION (Optional)
# ============================================================
MyAnimeList__ApiBaseUrl=https://api.myanimelist.net/v2
MyAnimeList__ApiToken=your_mal_api_token
MyAnimeList__WebBaseUrl=https://myanimelist.net

# ============================================================
# KOMETA CONFIGURATION (Optional)
# ============================================================
Kometa__AnimeIdsJsonUrl=https://raw.githubusercontent.com/Kometa-Team/Community-Configs/refs/heads/master/mdblist/anime_ids.json
