<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MetaAnime</RootNamespace>
    <UserSecretsId>4455767a-84f8-450d-b45f-1feee59978e5</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
    <DockerComposeProjectPath>..\..\docker-compose.dcproj</DockerComposeProjectPath>
    <!-- PublishTrimmed intentionally omitted: MVC does not support trimming (IL2026).
         The trimmer sets AppContext switch IsEnhancedModelMetadataSupported=false which
         prevents ModelMetadata.InitializeDynamicTypeInformation() from running, causing
         a NotSupportedException at startup inside InferParameterBindingInfoConvention. -->
  </PropertyGroup>

  <ItemGroup>
    <!--
      TrimmerRootAssembly only preserves entry-point-reachable members; for assemblies
      that are accessed purely via reflection or DI at runtime (MVC metadata providers,
      API versioning) we need preserve="all" via a root descriptor file.
    -->
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="10.0.0" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.23" />
    <PackageReference Include="Hangfire.Core" Version="1.8.23" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.21.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <PackageReference Include="Microsoft.Build.Framework" Version="18.4.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.7" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.14.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MetaAnime.Application\MetaAnime.Application.csproj" />
    <ProjectReference Include="..\MetaAnime.Infrastructure\MetaAnime.Infrastructure.csproj" />
    <ProjectReference Include="..\..\MetaAnime.ServiceDefaults\MetaAnime.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
