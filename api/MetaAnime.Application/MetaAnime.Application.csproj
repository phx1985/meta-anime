<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.Core" Version="1.8.25" />
    <PackageReference Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageReference Include="Mediator.SourceGenerator" Version="3.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.13" />
    <!-- Pin past Hangfire.Core's transitive Newtonsoft.Json 11.0.1 (NU1903 vulnerability);
         13.0.4 matches the version MetaAnime.Presentation resolves. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="RestSharp" Version="114.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MetaAnime.Core/MetaAnime.Core.csproj" />
    <ProjectReference Include="../MetaAnime.Domain/MetaAnime.Domain.csproj" />
    <ProjectReference Include="../MetaAnime.Infrastructure/MetaAnime.Infrastructure.csproj" />
    <ProjectReference Include="../MetaAnime.Infrastructure.Kometa/MetaAnime.Infrastructure.Kometa.csproj" />
    <ProjectReference Include="../MetaAnime.Infrastructure.MyAnimeList/MetaAnime.Infrastructure.MyAnimeList.csproj" />
    <ProjectReference Include="../MetaAnime.Infrastructure.Plex/MetaAnime.Infrastructure.Plex.csproj" />
    <ProjectReference Include="../MetaAnime.Infrastructure.Sonarr/MetaAnime.Infrastructure.Sonarr.csproj" />
  </ItemGroup>

</Project>
