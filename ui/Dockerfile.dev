# Development Dockerfile for Meta Anime UI (Angular)
FROM node:22-alpine

WORKDIR /app

# Install dependencies first (cached layer)
COPY meta-anime-ui/package.json meta-anime-ui/package-lock.json ./
RUN npm ci

# Expose Angular dev server port
EXPOSE 4200

# Enable file-system polling so hot-reload works inside Docker bind mounts
ENV CHOKIDAR_USEPOLLING=true

# Bind to all interfaces; poll for file changes; forward /api calls via proxy
CMD ["npx", "ng", "serve", "--host", "0.0.0.0", "--poll", "2000", "--proxy-config", "proxy.conf.json"]
