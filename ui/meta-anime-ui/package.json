{
  "name": "meta-anime-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "npm install",
    "start": "ng serve --open",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
